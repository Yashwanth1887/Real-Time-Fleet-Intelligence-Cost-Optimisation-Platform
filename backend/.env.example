APP_NAME=FleetGuard API
APP_ENV=development
APP_VERSION=1.0.0
LOG_LEVEL=INFO
API_PREFIX=/api/v1

DATABASE_URL=postgresql+psycopg://fleetguard:change-me@localhost:5432/fleetguard
MONGO_URL=mongodb://fleetguard:change-me@localhost:27017/?authSource=admin
REDIS_URL=redis://:change-me@localhost:6379/0
KAFKA_BOOTSTRAP_SERVERS=localhost:19092
IDLE_THRESHOLD_SECONDS=120
FUEL_PRICE_PER_LITRE=1.50
SAVINGS_ASSUMPTION=0.75
JWT_SECRET_KEY=replace-this-with-a-random-secret-of-at-least-32-characters
